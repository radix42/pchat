{
  "expo": {
    "name": "pchat",
    "slug": "pchat",
    "scheme": "pchat",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "android": { "package": "com.pchat.app" },
    "plugins": [
      "expo-secure-store",
      ["expo-build-properties", { "android": { "usesCleartextTraffic": true } }]
    ]
  }
}
